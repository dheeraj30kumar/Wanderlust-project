<% layout("/layouts/biolerplate") %>
<body>
    <style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
    }

    .filter {
        text-align: center;
        margin-top: 1.5rem;
        margin-right: 1.5rem;
        opacity: 0.7;
        text-decoration: none;
        color: black;
        min-width: 60px;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
        margin-top: 0.4rem;
        margin-bottom: 0;
    }

    .filter i {
        font-size: 1.3rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        min-height: 3.25rem;
        padding: 0.8rem 1rem;
        margin-left: auto;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    .listing-link {
        text-decoration: none;
        color: inherit;
    }

    .listing-card {
        border: none;
        margin-bottom: 2rem;
    }

    .listing-card img {
        width: 100%;
        height: 20rem;
        object-fit: cover;
        border-radius: 1rem;
    }

    .listing-card .card-body {
        padding: 0.75rem 0.25rem;
    }

    .listing-card .card-text {
        margin: 0;
    }

    /* Tablet */
    @media (max-width: 991px) {
        .tax-toggle {
            margin-left: 1rem;
        }

        .filter {
            margin-right: 1rem;
        }

        .listing-card img {
            height: 18rem;
        }
    }

    /* Mobile */
    @media (max-width: 767px) {

        #filters {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            gap: 1rem;
            padding: 0.5rem 0.25rem 1rem;
            scrollbar-width: none;
        }

        #filters::-webkit-scrollbar {
            display: none;
        }

        .filter {
            flex: 0 0 auto;
            margin: 1rem 0 0;
            min-width: 65px;
        }

        .filter i {
            font-size: 1.2rem;
        }

        .filter p {
            font-size: 0.7rem;
        }

        .tax-toggle {
            flex: 0 0 auto;
            margin-left: 0.5rem;
            min-height: 3rem;
            padding: 0.6rem 0.8rem;
            font-size: 0.75rem;
        }

        .listing-card {
            margin-bottom: 1.5rem;
        }

        .listing-card img {
            height: 16rem;
            border-radius: 0.8rem;
        }

        .listing-card .card-body {
            padding: 0.6rem 0.1rem;
        }
    }

    /* Small mobile */
    @media (max-width: 480px) {

        #filters {
            gap: 0.8rem;
        }

        .filter {
            min-width: 58px;
        }

        .filter p {
            font-size: 0.65rem;
        }

        .filter i {
            font-size: 1.1rem;
        }

        .tax-toggle {
            font-size: 0.7rem;
            padding: 0.5rem 0.7rem;
        }

        .listing-card img {
            height: 14rem;
        }
    }
</style>
    <!-- <h2>all Listings</h2> -->
    <!-- <form method="get" action="/listings/new">
        <button>create new listing</button>
    </form> -->
    <div id="filters">
        <a href="/listings?category=Trending" class="filter">
        <div >
            <div><i class="fa-notdog-duo fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        </a>
        <a href="/listings?category=Rooms" class="filter">
        <div>
            <div><i class="fa-mosaic fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter">
        <div>
            <div><i class="fa-sharp-duotone fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        </a>
        <a href="/listings?category=Castles" class="filter">
        <div>
            <div><i class="fa-mosaic fa-solid fa-bed"></i></div>
            <p>castles</p>
        </div>
        </a>
        <a href="/listings?category=Mountain" class="filter">
        <div>
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>mountain</p>
        </div>
        </a>
        <a href="/listings?category=Amazing Pools" class="filter">
        <div>
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing pools</p>
        </div>
        </a>
        <a href="/listings?category=Camping" class="filter">
        <div>
            <div><i class="fa-solid fa-tent-arrows-down"></i></div>
            <p>camping</p>
        </div>
        </a>
        <a href="/listings?category=Farm" class="filter">
        <div>
            <div><i class="fa-solid fa-seedling"></i></div>
            <p>farm</p>
        </div>
        </a>
        <a href="/listings?category=Arctic" class="filter">
        <div >
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
        </a>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" 
                id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">
                    Display Total after Taxes</label>
        </div>
    
        </div>
    </div>


    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1" >
        <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card" >
        <img src="<%= listing.image.url %>" class="card-img-top" 
        alt="listing_image"
        style="height: 20rem"
        >
        <div class="card-img-overlay">abcd</div>
        <div class="card-body">
            <p class="card-text">
                <b><%= listing.title %></b> <br/>
                &#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> /night
                <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
            </p>
        </div>
    </div>
</a>
<% } %>
    </div>

    
</body>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        console.log("clicked");
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline"
            }else{
                info.style.display = "none"
            }
        }
        
        
    })
</script>
